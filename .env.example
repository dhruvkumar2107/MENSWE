# -----------------------------------------------------------------------------
# MAISON HOMME — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit a populated .env or any real secret.
# -----------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# Development default (SQLite file, zero config):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) example:
# DATABASE_URL="postgresql://user:password@host:5432/maisonhomme?schema=public"

# Auth -----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Site -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Razorpay payments ----------------------------------------------------------
# Obtain from https://dashboard.razorpay.com/app/keys
# Leave blank to run the store in clearly-labelled SANDBOX mode (no live charge).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook signing secret from the Razorpay dashboard (Webhooks section)
RAZORPAY_WEBHOOK_SECRET=""

# Transactional email --------------------------------------------------------
# Leave blank to log email to the server console (dev mode).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MAISON HOMME <no-reply@your-domain.com>"

# Image storage (Cloudinary) -------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
